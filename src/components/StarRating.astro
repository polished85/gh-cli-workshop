---
import { formatRatingValue, getStarFillPercentages } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
const starFillPercentages = getStarFillPercentages(rating);
---

<div class="flex items-center">
    <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
        {rating !== null && (
            <span class="inline-flex mr-1" aria-label={`${formatRatingValue(rating)} rating`} role="img">
                {starFillPercentages.map((fill) => (
                    <span
                        class="text-base leading-none"
                        aria-hidden="true"
                        style={`background: linear-gradient(to right, #facc15 ${fill}%, #475569 ${fill}%); background-clip: text; -webkit-background-clip: text; color: transparent;`}
                    >
                        ★
                    </span>
                ))}
            </span>
        )}
        {formatRatingValue(rating)}
    </span>
</div>
